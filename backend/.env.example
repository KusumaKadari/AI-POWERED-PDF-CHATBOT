# ============================================================
# DocuMind Backend — Environment Variables
# ============================================================
# Copy this file to .env only if you need to override defaults.
# NEVER commit .env to Git — it may contain secrets.
#
# To copy: run this in PowerShell from the backend/ folder:
#   Copy-Item .env.example .env
# ============================================================

# Get a Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional overrides (defaults are set in config.py)
# MAX_UPLOAD_SIZE=10485760
# TOP_K_CHUNKS=5
# RELEVANCE_THRESHOLD=0.2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
