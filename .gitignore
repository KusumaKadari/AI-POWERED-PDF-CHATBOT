# ============================================================
# DocuMind — .gitignore
# ============================================================
# This file tells Git which files/folders to ignore.
# They won't be tracked, staged, or pushed to GitHub.
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# ----- Environment variables (SECRETS — never commit these) -----
.env
.env.local
.env.*.local

# ----- Node.js / React -----
node_modules/
dist/
.cache/
*.local

# ----- IDE and editor files -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Pytest -----
.pytest_cache/
.coverage
htmlcov/

# ----- Uploaded files (never commit user data) -----
uploads/
*.pdf

# ----- Model cache (large files, downloaded automatically) -----
.cache/
models/
